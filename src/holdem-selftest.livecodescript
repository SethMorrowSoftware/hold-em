command heTestShuffleRun
   local tDealA, tDeckList
   put return & "-- 3. keyed-stream shuffle core (spec 7.1, pure part)" & return after gRpt

   -- rejection sampling at the boundary: for n=52 the limit is 4294967280,
   -- so 0xFFFFFFFA (4294967290) must be rejected and the next word used,
   -- while 0xFFFFFFEF (4294967279) is accepted and maps to 52. Offsets
   -- are char positions into the hex stream (8 chars per word, v0.1.1)
   heTAssert "draw: word at the limit is rejected", heDrawUniform("fffffffa00000000", 1, 52), "1,17"
   heTAssert "draw: word under the limit is accepted", heDrawUniform("ffffffef", 1, 52), "52,9"

   -- the full Fisher-Yates against the pinned synthetic stream
   put heShuffleFromStream(kKatSynthStream) into tDeckList
   heTAssert "shuffle: synthetic-stream deck matches the KAT", heTNamesOf(tDeckList), kKatSynthDeck

   -- deal assignment order on that deck (3 seats, button 1 -> order 2,3,1)
   put heDealAssign(tDeckList, "1,2,3", 1) into tDealA
   heTAssert "deal: seat 1 holes", heTNamesOf(tDealA["holesBy"][1]), "3d,5d"
   heTAssert "deal: seat 2 holes", heTNamesOf(tDealA["holesBy"][2]), "Ac,5h"
   heTAssert "deal: seat 3 holes", heTNamesOf(tDealA["holesBy"][3]), "Kc,Kh"
   heTAssert "deal: flop", heTNamesOf(tDealA["flopList"]), "3h,2h,5c"
   heTAssert "deal: turn", heCardName(tDealA["turnIx"]), "4h"
   heTAssert "deal: river", heCardName(tDealA["riverIx"]), "Tc"
   heTAssert "deal: burns", heTNamesOf(tDealA["burnsList"]), "Qc,8c,4d"
end heTestShuffleRun

--------------------------------------------------------------------------
-- 4. transcript fold: replay determinism + replay-as-audit (plan 1e)
--------------------------------------------------------------------------

function heTKatLog pTamper
   -- the canned session: synthetic-deck hand, 3 seats, scripted actions.
   -- pTamper: empty for the honest log, "settle" or "badact" for the
   -- negative tests.
   local tLog, tSettleBody
   put empty into tLog
   put heEnvContentLine(kKatTableHex, 0, "seat0", "cfg", \
         "v=1,level=0,sb=1,bb=2,seats=1|2|3,stacks=400|400|400,button=1") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "seedCommit", "nocrypto") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat2", "seedCommit", "nocrypto") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat3", "seedCommit", "nocrypto") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "holeDeliver", "seat=1,cards=3d|5d") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "holeDeliver", "seat=2,cards=Ac|5h") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "holeDeliver", "seat=3,cards=Kc|Kh") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat2", "bidSB", "amount=1") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat3", "bidBB", "amount=2") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "act", "verb=raise,amount=6") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat2", "act", "verb=call,amount=5") & return after tLog
   if pTamper is "badact" then
      put heEnvContentLine(kKatTableHex, 1, "seat3", "act", "verb=call,amount=7") & return after tLog
   end if
   put heEnvContentLine(kKatTableHex, 1, "seat3", "act", "verb=call,amount=4") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "board", "street=flop,cards=3h|2h|5c") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat2", "act", "verb=check,amount=0") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat3", "act", "verb=bet,amount=10") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "act", "verb=call,amount=10") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat2", "act", "verb=fold,amount=0") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "board", "street=turn,cards=4h") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat3", "act", "verb=check,amount=0") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "act", "verb=check,amount=0") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "board", "street=river,cards=Tc") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat3", "act", "verb=bet,amount=20") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "act", "verb=call,amount=20") & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "seedReveal", "seat=1,seed=" & kKatZero64) & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat2", "seedReveal", "seat=2,seed=" & kKatZero64) & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat3", "seedReveal", "seat=3,seed=" & kKatZero64) & return after tLog
   put heEnvContentLine(kKatTableHex, 1, "seat1", "audit", "result=skipped-no-sodium") & return after tLog
   if pTamper is "settle" then
      put "deltas=1:52|2:-16|3:-36" into tSettleBody
   else
      put "deltas=1:42|2:-6|3:-36" into tSettleBody
   end if
   put heEnvContentLine(kKatTableHex, 1, "seat1", "settle", tSettleBody) & return after tLog
   return tLog
end heTKatLog

function heTFoldTxt pFoldA
   return pFoldA["stacksBy"][1] & "/" & pFoldA["stacksBy"][2] & "/" \
         & pFoldA["stacksBy"][3] & " hand=" & pFoldA["handNum"] \
         & " errs=[" & pFoldA["errors"] & "]"
end heTFoldTxt

command heTestFoldRun
   local tFoldA, tFoldB
   put return & "-- 4. transcript fold: determinism + replay-as-audit" & return after gRpt
   put heFoldTranscript(heTKatLog(empty)) into tFoldA
   heTAssert "fold: canned session settles to the pinned stacks", \
         heTFoldTxt(tFoldA), "442/394/364 hand=1 errs=[]"
   put heFoldTranscript(heTKatLog(empty)) into tFoldB
   heTAssert "fold: folding twice is bit-identical", heTFoldTxt(tFoldB), heTFoldTxt(tFoldA)
   heTContains "fold: per-hand trace recorded", tFoldA["trace"], "hand 1: 1:42|2:-6|3:-36"
   put heFoldTranscript(heTKatLog("settle")) into tFoldA
   heTContains "fold: tampered settle line is caught", tFoldA["errors"], "settle-mismatch"
   put heFoldTranscript(heTKatLog("badact")) into tFoldA
   heTContains "fold: wrong-amount action is rejected on replay", tFoldA["errors"], "engine-rejected"
end heTestFoldRun

--------------------------------------------------------------------------
-- 5. crypto-dependent KATs (SodiumXT) -- the on-engine half of
-- tools/protocol-kat.py; SKIPs cleanly when the extension is absent
--------------------------------------------------------------------------

command heTestSodiumRun
   local tSeedsA, tXorHex, tKeyData, tDeckList, tDealA, tCommitsA
   local tContent0, tPrevHex, tWireLine, tSeqNum, tChainData, tAuditTxt
   local tSenderSeeds, tHands, tTypes, tBodies
   put return & "-- 5. SodiumXT KATs (spec 6 + 7.1 crypto path)" & return after gRpt
   if not heHasSodium() then
      heTSkip "sodium: all crypto KATs", "SodiumXT not installed"
      exit heTestSodiumRun
   end if
   set the itemDelimiter to comma

   -- primitive equivalence: sxHash must be BLAKE2b-256 unkeyed
   heTAssert "sodium: sxHash(empty) is BLAKE2b-256", \
         heBin2Hex(heHashData(textEncode(empty, "UTF-8"))), kKatHashEmpty

   -- commit-reveal deal from the pinned seeds (hex end to end, H6)
   put kKatSeed1 into tSeedsA[1]
   put kKatSeed2 into tSeedsA[2]
   put kKatSeed3 into tSeedsA[3]
   heTAssert "sodium: seed commitment 1", heSeedCommitOf(kKatSeed1), kKatCommit1
   heTAssert "sodium: seed commitment 2", heSeedCommitOf(kKatSeed2), kKatCommit2
   heTAssert "sodium: seed commitment 3", heSeedCommitOf(kKatSeed3), kKatCommit3
   put heXorSeedsA(tSeedsA, 3) into tXorHex
   heTAssert "sodium: seeds XOR", tXorHex, kKatSeedsXor
   put heStreamKeyOf(heHex2Bin(kKatTableHex), 1, tXorHex) into tKeyData
   heTAssert "sodium: stream key", heBin2Hex(tKeyData), kKatStreamKey
   put heDeckFromStreamKey(tKeyData) into tDeckList
   heTAssert "sodium: full shuffled deck", heTNamesOf(tDeckList), kKatDeck
   put heDealAssign(tDeckList, "1,2,3", 1) into tDealA
   heTAssert "sodium: hole cards seat 1", heTNamesOf(tDealA["holesBy"][1]), kKatHole1
   heTAssert "sodium: hole cards seat 2", heTNamesOf(tDealA["holesBy"][2]), kKatHole2
   heTAssert "sodium: hole cards seat 3", heTNamesOf(tDealA["holesBy"][3]), kKatHole3
   heTAssert "sodium: flop", heTNamesOf(tDealA["flopList"]), kKatFlop
   heTAssert "sodium: turn", heCardName(tDealA["turnIx"]), kKatTurn
   heTAssert "sodium: river", heCardName(tDealA["riverIx"]), kKatRiver

   -- the audit must pass on the honest deal and name a corrupted step
   put heSeedCommitOf(kKatSeed1) into tCommitsA[1]
   put heSeedCommitOf(kKatSeed2) into tCommitsA[2]
   put heSeedCommitOf(kKatSeed3) into tCommitsA[3]
   put heAuditHand(heHex2Bin(kKatTableHex), 1, tSeedsA, tCommitsA, 3, tDealA, "1,2,3", 1) into tAuditTxt
   heTAssert "sodium: audit passes the honest deal", tAuditTxt, "pass"
   put kKatCommit1 into tCommitsA[2]
   put heAuditHand(heHex2Bin(kKatTableHex), 1, tSeedsA, tCommitsA, 3, tDealA, "1,2,3", 1) into tAuditTxt
   heTAssert "sodium: audit names a corrupted commit", tAuditTxt, "fail:commit-mismatch-position-2"

   -- identity + canonical envelope + chain (the tools/protocol-kat.py
   -- six-envelope fixture, rebuilt on-engine)
   heTAssert "sodium: sxSignKeypairFromSeed pubkey", \
         heBin2Hex(heSignPubFromSeed(heHex2Bin(kKatIdSeed1))), kKatIdPub1
   put heEnvContentLine(kKatTableHex, 0, kKatIdPub1, "cfg", kKatCfgBody) into tContent0
   heTAssert "sodium: canonical content line bytes", \
         heBin2Hex(textEncode(tContent0, "UTF-8")), kKatEnv0ContentHex
   heTAssert "sodium: sxSignDetached over the content line", \
         heBin2Hex(heSignDetachedOf(textEncode(tContent0, "UTF-8"), heHex2Bin(kKatIdSeed1))), \
         kKatEnv0SenderSig

   put kKatIdSeed1 & return & kKatIdSeed1 & return & kKatIdSeed2 & return \
         & kKatIdSeed3 & return & kKatIdSeed2 & return & kKatIdSeed3 into tSenderSeeds
   put "0,1,1,1,1,1" into tHands
   put "cfg,seedCommit,seedCommit,seedCommit,bidSB,bidBB" into tTypes
   put kKatCfgBody & return & kKatCommit1 & return & kKatCommit2 & return \
         & kKatCommit3 & return & "amount=1" & return & "amount=2" into tBodies
   put kKatZero64 into tPrevHex
   repeat with tSeqNum = 1 to 6
      put heEnvContentLine(kKatTableHex, item tSeqNum of tHands, \
            heBin2Hex(heSignPubFromSeed(heHex2Bin(line tSeqNum of tSenderSeeds))), \
            item tSeqNum of tTypes, line tSeqNum of tBodies) into tContent0
      put heWireBuild(tContent0, heHex2Bin(line tSeqNum of tSenderSeeds), tSeqNum, \
            tPrevHex, heHex2Bin(kKatIdSeed1)) into tWireLine
      put heChainNextOf(tWireLine) into tChainData
      put heBin2Hex(tChainData) into tPrevHex
   end repeat
   heTAssert "sodium: six-envelope chain head", tPrevHex, kKatChainHead6
   heTAssert "sodium: settlement receipt hash", \
         heSettleHashOf("1:-4,2:8,3:-4", tChainData), kKatSettleHash
end heTestSodiumRun
