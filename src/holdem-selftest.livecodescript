command heTestEvaluatorRun
   local tVecLine, tCardsTxt, tExpect, tLabel, tIdxList, tBase
   local tPermLines, tPermLine, tPermuted, tPos, tResList, tResA, tPairI, tPairJ
   local tCountA, tCountB, tBadPairs, tVecCount
   put "-- 1. evaluator (spec 8.2)" & return after gRpt

   repeat for each line tVecLine in heTVectors()
      set the itemDelimiter to "|"
      put item 1 of tVecLine into tCardsTxt
      put item 2 of tVecLine into tExpect
      put item 3 of tVecLine into tLabel
      put heTIdxOf(tCardsTxt) into tIdxList
      heTAssert "eval: " & tLabel, heEval7(tIdxList), tExpect
   end repeat

   -- order independence: fixed permutations, no randomness in a KAT
   put "7,6,5,4,3,2,1" & return & "4,5,6,7,1,2,3" & return \
         & "2,4,6,1,3,5,7" & return & "5,1,7,3,6,2,4" into tPermLines
   put 0 into tBadPairs
   repeat for each line tVecLine in heTVectors()
      set the itemDelimiter to "|"
      put heTIdxOf(item 1 of tVecLine) into tIdxList
      set the itemDelimiter to comma
      put heEval7(tIdxList) into tBase
      repeat for each line tPermLine in tPermLines
         put empty into tPermuted
         repeat for each item tPos in tPermLine
            put item tPos of tIdxList & comma after tPermuted
         end repeat
         delete char -1 of tPermuted
         if heEval7(tPermuted) is not tBase then
            add 1 to tBadPairs
         end if
      end repeat
   end repeat
   heTAssert "eval: order independence (24 hands x 4 permutations)", tBadPairs, 0

   -- antisymmetry: the packed encoding is a total order over the vectors
   put 0 into tPos
   repeat for each line tVecLine in heTVectors()
      set the itemDelimiter to "|"
      add 1 to tPos
      put heEval7(heTIdxOf(item 1 of tVecLine)) into tResA[tPos]
   end repeat
   put tPos into tVecCount
   put 0 into tBadPairs
   repeat with tPairI = 1 to tVecCount - 1
      repeat with tPairJ = tPairI + 1 to tVecCount
         put tResA[tPairI] > tResA[tPairJ] into tCountA
         put tResA[tPairJ] > tResA[tPairI] into tCountB
         if tResA[tPairI] is tResA[tPairJ] then
            if tCountA or tCountB then
               add 1 to tBadPairs
            end if
         else
            if tCountA is tCountB then
               add 1 to tBadPairs
            end if
         end if
      end repeat
   end repeat
   heTAssert "eval: antisymmetry over all vector pairs", tBadPairs, 0
end heTestEvaluatorRun

